# Graphify's machine-generated graph, cache, HTML, and extraction manifests.
# Paper relationship conclusions are persisted in each 01-Papers/library/{slug}.json `relationships`.
graphify-out/

# Local Python bytecode, MCP downloads, and environment credentials.
__pycache__/
*.py[cod]
.claude/mcp-cache/
.env
.env.*

# Per-user agent choice; authentication stays in the CLI credential store.
.research-harness-agent.json
.research-harness-agent.tmp

# Local harness preferences and caches.
.omp/config.yml
*.local.md
.cache/
node_modules/
04-Projects/reader-threads/

# Personal research records stay local; shared templates and venue references remain versioned.
/00-Inbox/concept-candidates/
/01-Papers/index.md
/01-Papers/keep.md
/01-Papers/favorites.md
/01-Papers/library/
