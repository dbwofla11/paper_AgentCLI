      "claims": [
        {
          "statement": "SFO는 X-ray transform의 range–slow-time slope로 추정하고 Farrow fractional-delay resampling으로 보정한다.",
          "kind": "paper_fact",
          "evidence": [
            {
              "locator": "§VIII-A, p.470, Eq.44, Figs.14–15",
              "source": "01-Papers/pdfs/other/2024-aguilar-uncoupled-digital-radars.pdf"
            }
          ]
        },
        {
          "statement": "CFO/STO는 reciprocal shift symmetry와 두 1D profile cross-correlation을 이용해 추정하고 시간영역에서 보정한다.",
          "kind": "paper_fact",
          "evidence": [
            {
              "locator": "§VIII-B, pp.470–471, Eqs.45–46, Fig.16",
              "source": "01-Papers/pdfs/other/2024-aguilar-uncoupled-digital-radars.pdf"
            }
          ]
        },
        {
          "statement": "CSI 관측에서 raw waveform resampling과 reciprocal pair가 자동 확보되지 않아 별도 관측 adapter 및 calibration 계약이 필요하다.",
          "kind": "inference",
          "evidence": [
            {
              "locator": "§II-C, §VIII-A/B",
              "source": "01-Papers/pdfs/other/2024-aguilar-uncoupled-digital-radars.pdf"
            }
          ]
        }
