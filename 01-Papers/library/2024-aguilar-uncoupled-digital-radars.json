  "review": {
    "problem_and_prior_work": {
      "summary": "RF/LF 배선 없이 쓰는 레이다의 clock mismatch가 coherent processing을 훼손한다.",
      "claims": [
        {
          "statement": "RF coupled와 LF coupled 모두 reference distribution을 요구하며 기존 uncoupled FMCW/PMCW 접근이 있다.",
          "kind": "paper_fact",
          "evidence": [
            {
              "locator": "§I, pp.459–460, References[16–19]",
              "source": "01-Papers/pdfs/other/2024-aguilar-uncoupled-digital-radars.pdf"
